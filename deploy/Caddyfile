{$GMF_HOST} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}
	# A statement PDF (and the page image sent to the AI reader) is larger than any other request. The app checks the
	# session before reading these bodies and keeps its own caps (6 MiB for the PDF, 1.5 MiB for the image).
	@billFiles path /api/bill-files /api/bill-files/vision
	handle @billFiles {
		request_body {
			max_size 6MiB
		}
		reverse_proxy app:8080
	}
	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy app:8080
	}
}
