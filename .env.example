PORT=8080
DB_PATH=data/gmf.sqlite
APP_VERSION=dev

# Source (Meu Pluggy). Leave empty to skip it.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# One entry per connection: Label:itemId, separated by commas.
PLUGGY_ITEMS=

# Login (single user). Generate with: npm run auth:setup
AUTH_PASSWORD_HASH=
AUTH_TOTP_SECRET=
AUTH_RECOVERY_HASHES=
# Set to off only for local development over plain HTTP.
COOKIE_SECURE=

# AI (Plan G). Only needed to run the model evaluation locally; the server reads it from Key Vault.
OPENROUTER_API_KEY=
# Categorizer (needs the key above). Models and monthly budget in US$ are optional.
AI_ENABLED=
AI_MODEL=
AI_FALLBACK_MODEL=
AI_MONTHLY_BUDGET_USD=
AI_MATCH_MODEL=
# Address people use in the browser. Passkeys are tied to it, so it must stay the same. http://localhost:5173 works for development.
PUBLIC_ORIGIN=
