{
  "name": "gata-molhada-finance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/main.ts",
    "test": "node --test --disable-warning=ExperimentalWarning \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "sync": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/sync/cli.ts",
    "accounts": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/reconcile/cli.ts",
    "reconcile": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/reconcile/reconcile-cli.ts",
    "refresh": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/scheduler/refresh-cli.ts",
    "watch": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/scheduler/watch-cli.ts",
    "auth:setup": "node --disable-warning=ExperimentalWarning src/auth/setup-cli.ts",
    "quota": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/scheduler/quota-cli.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "eval:categorize": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning eval/ai/run-categorize.ts",
    "eval:analyst": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning eval/ai/run-analyst.ts",
    "categorize": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/ai/cli.ts",
    "eval:pairs": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning eval/ai/run-pairs.ts",
    "restore:backup": "node --disable-warning=ExperimentalWarning src/backup/restore-cli.ts",
    "shots": "node --disable-warning=ExperimentalWarning scripts/shots/run.ts"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "preact": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
