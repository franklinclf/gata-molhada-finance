{
  "name": "gata-molhada-finance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/main.ts",
    "test": "node --test --disable-warning=ExperimentalWarning \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "sync": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/sync/cli.ts",
    "accounts": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/reconcile/cli.ts",
    "reconcile": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/reconcile/reconcile-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
